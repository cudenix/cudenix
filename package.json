{
	"name": "@cudenix/cudenix",
	"version": "0.0.65",
	"description": "cudenix",
	"keywords": [
		"api",
		"bun",
		"cudenix",
		"framework",
		"http",
		"server",
		"typescript",
		"web"
	],
	"homepage": "https://github.com/cudenix/cudenix",
	"bugs": {
		"url": "https://github.com/cudenix/cudenix/issues",
		"email": "security@cudenix.com"
	},
	"license": "MIT",
	"author": "cudenix <contact@cudenix.com> (https://cudenix.com)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cudenix/cudenix.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/ecosystem/client/index.d.ts",
			"import": "./dist/ecosystem/client/index.js"
		},
		"./compress": {
			"types": "./dist/ecosystem/plugins/compress/index.d.ts",
			"import": "./dist/ecosystem/plugins/compress/index.js"
		},
		"./cors": {
			"types": "./dist/ecosystem/plugins/cors/index.d.ts",
			"import": "./dist/ecosystem/plugins/cors/index.js"
		},
		"./package.json": "./package.json",
		"./standard-schema": {
			"types": "./dist/ecosystem/plugins/standard-schema/index.d.ts",
			"import": "./dist/ecosystem/plugins/standard-schema/index.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"scripts": {
		"build": "bun check && bun typecheck && bun scripts/build.ts",
		"check": "oxfmt --check && oxlint",
		"format": "oxfmt",
		"lint": "oxlint",
		"test": "bun typecheck && bun test --coverage",
		"typecheck": "tsc --noEmit --builders 8 --checkers 8"
	},
	"devDependencies": {
		"@oxlint/plugins": "1.93.0",
		"@types/bun": "1.4.4",
		"eslint-plugin-perfectionist": "5.13.0",
		"oxfmt": "0.78.0",
		"oxlint": "1.93.0",
		"oxlint-tsgolint": "7.0.2007",
		"typescript": "7.0.2"
	},
	"trustedDependencies": []
}
